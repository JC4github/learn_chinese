{
  "name": "Hanzi Path — Personal Mandarin Reader",
  "short_name": "Hanzi Path",
  "description": "Short personalised Mandarin stories, vocabulary, and review.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f0e4",
  "theme_color": "#173f38",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./icons/icon-lu-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-lu-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-lu-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-lu.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
